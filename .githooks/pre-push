#!/bin/sh
# Runs CI's checks before a push, since CI only says so after master broke.
# Cloud sessions can't download Electrobun's SDK (.hutch/devkit), which lint
# and typecheck need, so there those two are left to CI.
set -e
cd "$(git rev-parse --show-toplevel)"
if [ -d .hutch/devkit ]; then
  exec bun run check
fi
echo 'pre-push: no .hutch/devkit, so lint and typecheck are left to CI' >&2
bun run format:check
bun run test
