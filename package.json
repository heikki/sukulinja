{
  "name": "sukulinja",
  "module": "src/server/index.ts",
  "type": "module",
  "private": true,
  "license": "Unlicense",
  "scripts": {
    "dev": "bun run --hot src/server/dev.ts",
    "dev:app": "electrobun build && electrobun dev",
    "build:app": "electrobun build",
    "import-ged": "bun run scripts/import-ged.ts",
    "sync": "electrobun sync",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@total-typescript/tsconfig": "^1.0.4",
    "@types/bun": "1.4.2",
    "eslint": "10.9.0",
    "eslint-config-love": "155.0.0",
    "prettier": "3.9.6",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "electrobun": "2.0.1",
    "lit": "^3.3.3"
  }
}
